# ─── App ────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3000
API_PREFIX=api
# Frontend origin — used for CORS whitelist and links in emails
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=silent

# ─── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://iam:iam_password@localhost:5433/iam_test?schema=public

# ─── Redis (rate limiting, BullMQ, token denylist, login back-off) ──
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────────────
# Generate each secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# Access token lifetime in seconds (15 min)
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# Refresh token lifetime in days (default / with "remember me")
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30
# Short-lived token issued between password check and TOTP verification
JWT_2FA_SECRET=change-me-2fa-secret-at-least-32-characters
JWT_2FA_TTL=300
JWT_ISSUER=iam-platform
JWT_AUDIENCE=iam-platform-web

# ─── Cookies ────────────────────────────────────────────────────────
# Leave empty for host-only cookies (recommended for localhost)
COOKIE_DOMAIN=

# ─── Two-factor authentication ──────────────────────────────────────
# 32-byte key, base64 encoded, used to encrypt TOTP secrets at rest: openssl rand -base64 32
TWO_FACTOR_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Name shown in Google / Microsoft Authenticator
TWO_FACTOR_ISSUER=IAM Platform

# ─── Security policy ────────────────────────────────────────────────
BCRYPT_ROUNDS=4
PASSWORD_HISTORY_DEPTH=5
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MIN=15
REVOKE_SESSIONS_ON_PASSWORD_CHANGE=true
# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL seconds
THROTTLE_TTL=60
THROTTLE_LIMIT=10000

# ─── Mail (Mailpit in development: http://localhost:8025) ───────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IAM Platform <no-reply@iam.local>"

# ─── Seed ───────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@iam.local
SEED_ADMIN_PASSWORD=Admin#Passw0rd!2026
