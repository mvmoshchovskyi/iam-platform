<p>Hi {{name}},</p>
{{#if isEmailChange}}
  <p>You asked to change the email address on your account to <strong>{{to}}</strong>. Confirm the new address to complete the change.</p>
{{else}}
  <p>Thanks for signing up! Please confirm your email address to activate your account.</p>
{{/if}}
<p style="text-align:center;margin:28px 0;">
  <a href="{{url}}" style="background:#18181b;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;display:inline-block;">Confirm email</a>
</p>
<p style="font-size:13px;color:#71717a;">The link expires in 24 hours. If you didn't request this, you can ignore this email.</p>
